# Copy the variables you need into the repo-root .env (or projects/sec_graphrag/.env).
# Never commit real values.

# --- Neo4j (required) ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<username>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=<database>

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...

# --- LangSmith (required from step 0.5) ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sec-graphrag

# --- SEC EDGAR (required from M1): your name and email, sent as the User-Agent ---
EDGAR_IDENTITY="Your Name your@email.com"

# --- Optional model overrides ---
# EXTRACT_MODEL=gpt-5-mini
# ANSWER_MODEL=gpt-5-mini
# JUDGE_MODEL=gpt-5.2
# EMBEDDING_MODEL=text-embedding-3-small
